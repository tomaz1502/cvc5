; REQUIRES: cocoa
; COMMAND-LINE: --nl-div-ideal
; EXPECT: unsat
; Cancellation law for congruences:
;   a*x = a*y (mod n) and gcd(a, n) = 1 imply x = y (mod n)
; where the hypotheses are given by their witnesses. This holds since y - x is
; in the ideal generated by a*y - a*x - n*d, a*u + n*v - 1 and n.
(set-logic QF_NIA)
(set-info :status unsat)
(declare-const a Int)
(declare-const n Int)
(declare-const x Int)
(declare-const y Int)
(declare-const d Int)
(declare-const u Int)
(declare-const v Int)
(assert (> n 0))
(assert (= (- (* a y) (* a x)) (* n d)))
(assert (= (+ (* a u) (* n v)) 1))
(assert (not (= (mod (- y x) n) 0)))
(check-sat)
